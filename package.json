{
  "name": "aibs-setup",
  "version": "0.1.5",
  "private": true,
  "description": "AI Builder School setup wizard",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "test:ui": "node tests/ui-flow.test.mjs && node tests/links-and-feedback.test.mjs && node tests/install-progress.test.mjs",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:linux": "tauri build --bundles deb,appimage,rpm",
    "build:mac": "tauri build --bundles dmg,app",
    "build:win": "tauri build --bundles nsis",
    "screenshots": "node tests/capture-screenshots.mjs",
    "build:local": "./scripts/build-local.sh",
    "verify:appimage": "./scripts/verify-appimage.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "playwright": "^1.49.0"
  },
  "dependencies": {
    "@tauri-apps/plugin-opener": "^2.7.2"
  }
}
